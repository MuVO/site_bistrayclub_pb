# Публичные настройки сайта. Локальные значения соответствуют настройкам сайта на GitHub.
PUBLIC_SITE_DOMAIN=pb.bistray.club
# Оставьте пустым при локальной проверке, чтобы тестовая заявка не ушла в рабочий сервис.
PUBLIC_CONTACT_FUNCTION_URL=
PUBLIC_PHONE_NUMBER=+7 (999) 444-01-74
PUBLIC_CLUB_ADDRESS=КСК «Быстрай»
PUBLIC_OPENING_HOURS=Вт—Вс: 11:00 — 19:00
PUBLIC_PRICE_PER_PLAYER=1500
PUBLIC_MIN_PLAYERS=6
PUBLIC_INCLUDED_BALLS=200

# Параметры статичного превью и интерактивной карты Яндекса.
